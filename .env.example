# Reference only: the application reads exported environment variables, not this file.
# Leave tokens unset for read-only access. For a local review demo, run:
# uv run --locked python -m apps.api --demo
# Or generate independent tokens with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# JAGA_REVIEWER_TOKEN=<32-to-256-character-random-token>
# JAGA_SUPERVISOR_TOKEN=<different-random-token>
# JAGA_REVIEWER_ID=demo-reviewer
# JAGA_SUPERVISOR_ID=demo-supervisor
# JAGA_DB_PATH=var/jaga-jkn.sqlite3
# JAGA_DATA_ROOT=data/synthetic/curated
# JAGA_DATASET_MANIFEST=config/backend_dataset_manifest.json
