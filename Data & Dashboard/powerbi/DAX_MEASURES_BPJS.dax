// ==============================================================================
// JAGA-JKN: DAX MEASURES (CANONICAL REBIND & COMPLIANCE INTELLIGENCE)
// Divalidasi terhadap dataset kanonis powerbi/data/ dan aturan tata kelola
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. VOLUME OBSERVASI & ENTITAS TERPANTAU
// ------------------------------------------------------------------------------

Total Entitas Terpantau = 
DISTINCTCOUNT(Dim_Badan_Usaha[id_badan_usaha])

Total Observasi Bulanan = 
COUNTROWS(Fact_Risk_Evidence)

// ------------------------------------------------------------------------------
// 2. DISKREPANSI FAKTUAL TERAMATI (OBSERVED DISCREPANCIES)
// Catatan: Ini adalah observasi sinyal fisik/administratif, bukan vonis pelanggaran hukum.
// ------------------------------------------------------------------------------

Kasus Diskrepansi Kepesertaan = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[registration_discrepancy_detected] = TRUE()
)

Rasio Diskrepansi Kepesertaan = 
DIVIDE(
    [Kasus Diskrepansi Kepesertaan],
    [Total Observasi Bulanan],
    0
)

Kasus Diskrepansi Upah = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[wage_discrepancy_detected] = TRUE()
)

Rasio Diskrepansi Upah = 
DIVIDE(
    [Kasus Diskrepansi Upah],
    [Total Observasi Bulanan],
    0
)

Kasus Gap Pembayaran Iuran = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[contribution_payment_gap_observed] = TRUE()
)

Rasio Gap Pembayaran Iuran = 
DIVIDE(
    [Kasus Gap Pembayaran Iuran],
    [Total Observasi Bulanan],
    0
)

Kasus Terindikasi Diskrepansi = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[registration_discrepancy_detected] = TRUE() ||
    Fact_Risk_Evidence[wage_discrepancy_detected] = TRUE() ||
    Fact_Risk_Evidence[contribution_payment_gap_observed] = TRUE()
)

Rasio Entitas Terindikasi = 
DIVIDE(
    [Kasus Terindikasi Diskrepansi],
    [Total Observasi Bulanan],
    0
)

// ------------------------------------------------------------------------------
// 3. KUALITAS BUKTI & PEMISAHAN KASUS (EVIDENCE QUALITY TRIAGE)
// Membedakan mana kasus dengan bukti kuat vs mana yang belum cukup bukti
// ------------------------------------------------------------------------------

Diskrepansi Kepesertaan Bukti Kuat (HIGH) = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[registration_discrepancy_detected] = TRUE(),
    Fact_Risk_Evidence[registration_evidence_quality] = "HIGH"
)

Diskrepansi Kepesertaan Bukti Sedang (MEDIUM) = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[registration_discrepancy_detected] = TRUE(),
    Fact_Risk_Evidence[registration_evidence_quality] = "MEDIUM"
)

Diskrepansi Kepesertaan Bukti Lemah (LOW) = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[registration_discrepancy_detected] = TRUE(),
    Fact_Risk_Evidence[registration_evidence_quality] = "LOW"
)

Kasus Butuh Pengayaan Bukti = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[registration_discrepancy_detected] = TRUE(),
    Fact_Risk_Evidence[registration_evidence_quality] IN {"MEDIUM", "LOW"}
)

Proporsi Kasus Siap Telaah Petugas = 
DIVIDE(
    [Diskrepansi Kepesertaan Bukti Kuat (HIGH)],
    [Kasus Diskrepansi Kepesertaan],
    0
)

// ------------------------------------------------------------------------------
// 4. TRANSPARANSI TATA KELOLA & REGULASI (GOVERNANCE TRANSPARENCY)
// Kebijakan fail-closed: Abstain jika dasar aturan B1/B2 belum disahkan
// ------------------------------------------------------------------------------

Kasus Diblokir Tata Kelola = 
CALCULATE(
    COUNTROWS(Fact_Risk_Evidence),
    Fact_Risk_Evidence[flag_governance_blocked] = 1
)

Status Otoritas Regulasi = 
"ABSTAIN - Kewenangan Regulasi B1/B2 Belum Disahkan (Fail-Closed)"

Status Prior Sektor = 
"NO_EMPIRICAL_PRIOR__DO_NOT_INFER_SIGNAL_FROM_SECTOR_ALONE"

// ------------------------------------------------------------------------------
// 5. ESTIMASI PAPARAN FINANSIAL SINTETIS (EXPOSURE ESTIMATE)
// Catatan: Estimasi simulasi, bukan kerugian empiris yang diputuskan hukum
// ------------------------------------------------------------------------------

Total Estimasi Paparan Sintetis (Rp) = 
SUM(Fact_Risk_Evidence[estimated_exposure_synthetic_rp])

Rata-rata Paparan per Kasus Diskrepansi = 
DIVIDE(
    [Total Estimasi Paparan Sintetis (Rp)],
    [Kasus Terindikasi Diskrepansi],
    0
)

Keterangan Paparan Finansial = 
"SIMULATED_ESTIMATE__NOT_EMPIRICAL_LOSS__NOT_FOR_DECISION"

// ------------------------------------------------------------------------------
// 6. LOG TINJAUAN PETUGAS (HUMAN-IN-THE-LOOP AUDIT TRAIL)
// Dari Fact_Human_Review_Synthetic
// ------------------------------------------------------------------------------

Total Kasus Ditinjau Petugas = 
COUNTROWS(Fact_Human_Review_Synthetic)

Tinjauan Dikonfirmasi Petugas = 
CALCULATE(
    COUNTROWS(Fact_Human_Review_Synthetic),
    Fact_Human_Review_Synthetic[human_review_outcome_synthetic] = "REVIEW_CONFIRMED"
)

Tinjauan Butuh Bukti Tambahan = 
CALCULATE(
    COUNTROWS(Fact_Human_Review_Synthetic),
    Fact_Human_Review_Synthetic[human_review_outcome_synthetic] = "REQUEST_MORE_EVIDENCE"
)

Tinjauan Tanpa Tindakan Lanjut = 
CALCULATE(
    COUNTROWS(Fact_Human_Review_Synthetic),
    Fact_Human_Review_Synthetic[human_review_outcome_synthetic] = "NO_ACTION_AFTER_REVIEW"
)

Tingkat Konfirmasi Petugas = 
DIVIDE(
    [Tinjauan Dikonfirmasi Petugas],
    [Total Kasus Ditinjau Petugas],
    0
)

Kasus Resolusi Selesai (Resolved) = 
CALCULATE(
    COUNTROWS(Fact_Human_Review_Synthetic),
    Fact_Human_Review_Synthetic[simulated_resolution_state] = "RESOLVED_SYNTHETIC"
)

Kasus Sedang Monitoring = 
CALCULATE(
    COUNTROWS(Fact_Human_Review_Synthetic),
    Fact_Human_Review_Synthetic[simulated_resolution_state] = "MONITORING"
)

Kasus Terbuka (Open) = 
CALCULATE(
    COUNTROWS(Fact_Human_Review_Synthetic),
    Fact_Human_Review_Synthetic[simulated_resolution_state] = "OPEN"
)
